// Modelo de datos — Finanzas 0→100 (cifrado de conocimiento cero, modo híbrido)
//
// Ver docs/arquitectura-cifrado.md. Resumen:
// - Todo dato financiero pertenece a un Household. Cada hogar tiene una clave simétrica
//   (XChaCha20-Poly1305) que solo conocen sus miembros: el servidor guarda esa clave
//   envuelta con la clave pública de cada miembro (HouseholdMemberKey).
// - EN CLARO (el servidor lo usa para filtrar, paginar y sincronizar): IDs, relaciones,
//   fechas, tipos, estados, monedas y parámetros estructurales (día de cierre, frecuencia…).
// - CIFRADO (columna `payload`, JSON cifrado en el navegador): montos, tasas, cantidades,
//   precios, nombres, descripciones y notas. El servidor nunca puede leerlo.
//   `keyVersion` indica qué versión de la clave del hogar cifró el payload.
// - Sincronización offline: cada tabla sincronizable tiene `revision` (secuencia global
//   asignada por trigger en cada INSERT/UPDATE) y `deletedAt` (lápida para borrados).
// - IDs: UUID v7. Fechas contables: @db.Date. Marcas de tiempo: timestamptz (UTC).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

// ─────────────────────────────────────────────────────────────
// Identidad y claves
// ─────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique @db.Citext
  passwordHash          String // contraseña de LOGIN (scrypt, @nestjs/authentication)
  displayName           String // visible para los miembros de sus hogares
  locale                String    @default("es-AR")
  timezone              String    @default("America/Argentina/Buenos_Aires")
  defaultHouseholdId    String?   @db.Uuid
  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime? @db.Timestamptz
  emailVerifiedAt       DateTime? @db.Timestamptz
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  keys                UserKeys?
  defaultHousehold    Household?            @relation("UserDefaultHousehold", fields: [defaultHouseholdId], references: [id], onDelete: SetNull)
  memberships         HouseholdMember[]
  memberKeys          HouseholdMemberKey[]  @relation("MemberKeyRecipient")
  memberKeysWrapped   HouseholdMemberKey[]  @relation("MemberKeyWrapper")
  invitationsSent     HouseholdInvitation[] @relation("InvitationInviter")
  ownedAccounts       Account[]             @relation("AccountOwner")
  transactionsCreated Transaction[]         @relation("TransactionCreator")
  transactionSplits   TransactionSplit[]
  remindersCreated    Reminder[]
  notifications       Notification[]
  tipDismissals       TipDismissal[]

  @@map("users")
}

/// Material criptográfico del usuario. Las claves privadas NUNCA llegan en claro:
/// el navegador las cifra con una clave derivada (Argon2id) de la clave de descifrado,
/// y una segunda copia con la clave derivada de la frase de recuperación (24 palabras).
model UserKeys {
  userId                String   @id @db.Uuid
  keyVersion            Int      @default(1) // sube al resetear claves (pérdida de clave + frase)
  publicKey             Bytes // X25519, para recibir claves de hogar
  signingPublicKey      Bytes // Ed25519, para verificar quién envolvió una clave
  encryptedPrivateKeys  Bytes // privadas cifradas con la clave de descifrado
  kdfSalt               Bytes
  kdfParams             Json // { alg: "argon2id13", opsLimit, memLimit }
  recoveryEncryptedKeys Bytes // privadas cifradas con la frase de recuperación
  recoveryKdfSalt       Bytes
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_keys")
}

// ─────────────────────────────────────────────────────────────
// Hogares y claves de hogar
// ─────────────────────────────────────────────────────────────

enum HouseholdRole {
  OWNER // todo, incluido borrar el hogar y gestionar miembros
  ADMIN // todo menos borrar el hogar
  MEMBER // carga y edita datos
  VIEWER // solo lectura
}

enum MemberStatus {
  PENDING_KEY // aceptó (o reseteó sus claves) y espera que un admin le comparta la clave del hogar
  ACTIVE
}

/// payload: { name, financialLevel }
model Household {
  id                String   @id @default(uuid(7)) @db.Uuid
  baseCurrency      String   @db.VarChar(10)
  isPersonal        Boolean  @default(false)
  currentKeyVersion Int      @default(1)
  payload           Bytes
  keyVersion        Int
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @updatedAt @db.Timestamptz

  currency          Currency                @relation(fields: [baseCurrency], references: [code])
  keys              HouseholdKey[]
  members           HouseholdMember[]
  invitations       HouseholdInvitation[]
  defaultForUsers   User[]                  @relation("UserDefaultHousehold")
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  recurringRules    RecurringRule[]
  budgets           Budget[]
  debts             Debt[]
  installmentPlans  InstallmentPlan[]
  savingsGoals      SavingsGoal[]
  assets            Asset[]
  manualPrices      ManualAssetPrice[]
  investmentTrades  InvestmentTransaction[]
  fixedTermDeposits FixedTermDeposit[]
  exchangeRates     HouseholdExchangeRate[]
  netWorthSnapshots NetWorthSnapshot[]
  healthScores      FinancialHealthScore[]
  milestones        MilestoneCompletion[]
  reminders         Reminder[]
  notifications     Notification[]

  @@map("households")
}

/// Cada versión de la clave del hogar. Se rota al quitar un miembro: lo nuevo se cifra
/// con la versión nueva (el miembro quitado no puede leerlo).
model HouseholdKey {
  householdId String   @db.Uuid
  version     Int
  createdAt   DateTime @default(now()) @db.Timestamptz

  household  Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  memberKeys HouseholdMemberKey[]

  @@id([householdId, version])
  @@map("household_keys")
}

/// La clave del hogar (versión `version`) envuelta con la clave pública del miembro
/// (sealed box X25519) y firmada por quien la envolvió.
model HouseholdMemberKey {
  householdId    String   @db.Uuid
  version        Int
  userId         String   @db.Uuid
  userKeyVersion Int // versión de UserKeys con la que se envolvió
  wrappedKey     Bytes
  signature      Bytes // Ed25519 de quien envolvió, sobre (householdId, version, userId, wrappedKey)
  wrappedById    String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  householdKey HouseholdKey @relation(fields: [householdId, version], references: [householdId, version], onDelete: Cascade)
  user         User         @relation("MemberKeyRecipient", fields: [userId], references: [id], onDelete: Cascade)
  wrappedBy    User         @relation("MemberKeyWrapper", fields: [wrappedById], references: [id], onDelete: Cascade)

  @@id([householdId, version, userId])
  @@index([userId])
  @@map("household_member_keys")
}

model HouseholdMember {
  householdId String        @db.Uuid
  userId      String        @db.Uuid
  role        HouseholdRole
  status      MemberStatus  @default(PENDING_KEY)
  joinedAt    DateTime      @default(now()) @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model HouseholdInvitation {
  id          String        @id @default(uuid(7)) @db.Uuid
  householdId String        @db.Uuid
  email       String        @db.Citext
  role        HouseholdRole
  tokenHash   String        @unique
  invitedById String        @db.Uuid
  expiresAt   DateTime      @db.Timestamptz
  acceptedAt  DateTime?     @db.Timestamptz
  revokedAt   DateTime?     @db.Timestamptz
  createdAt   DateTime      @default(now()) @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
  @@map("household_invitations")
}

// ─────────────────────────────────────────────────────────────
// Datos públicos (en claro): monedas, cotizaciones y precios de mercado
// ─────────────────────────────────────────────────────────────

model Currency {
  code     String  @id @db.VarChar(10) // ISO 4217 o código propio (USDT, BTC)
  name     String
  symbol   String
  decimals Int     @default(2)
  isCrypto Boolean @default(false)

  households   Household[]
  ratesAsBase  ExchangeRate[] @relation("RateBase")
  ratesAsQuote ExchangeRate[] @relation("RateQuote")

  @@map("currencies")
}

/// Cotizaciones públicas traídas por el job (API). 1 `base` = `rate` `quote`.
model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  base      String   @db.VarChar(10)
  quote     String   @db.VarChar(10)
  rateType  String   @default("official") // official, blue, mep, ccl, tarjeta…
  rate      Decimal  @db.Decimal(24, 10)
  date      DateTime @db.Date
  provider  String
  createdAt DateTime @default(now()) @db.Timestamptz

  baseCurrency  Currency @relation("RateBase", fields: [base], references: [code])
  quoteCurrency Currency @relation("RateQuote", fields: [quote], references: [code])

  @@unique([base, quote, rateType, date, provider])
  @@index([base, quote, date])
  @@map("exchange_rates")
}

enum AssetClass {
  STOCK
  CEDEAR
  BOND
  ETF
  MUTUAL_FUND // FCI
  CRYPTO
  STABLECOIN
  REAL_ESTATE
  OTHER
}

/// householdId null = activo del catálogo público (symbol/name en claro, precios por API).
/// Con householdId = activo propio del hogar: symbol/name van en el payload cifrado.
model Asset {
  id               String     @id @default(uuid(7)) @db.Uuid
  householdId      String?    @db.Uuid
  assetClass       AssetClass
  currency         String     @db.VarChar(10)
  symbol           String?
  name             String?
  market           String?
  priceProviderKey String?
  payload          Bytes? // solo activos propios: { symbol, name, market }
  keyVersion       Int?
  revision         BigInt     @default(0)
  updatedAt        DateTime   @updatedAt @db.Timestamptz
  deletedAt        DateTime?  @db.Timestamptz

  household    Household?              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  prices       AssetPrice[]
  manualPrices ManualAssetPrice[]
  trades       InvestmentTransaction[]

  @@unique([symbol, market])
  @@index([householdId, revision])
  @@map("assets")
}

/// Precios públicos (job de API) de activos del catálogo.
model AssetPrice {
  assetId  String   @db.Uuid
  date     DateTime @db.Date
  price    Decimal  @db.Decimal(24, 10)
  provider String

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, date, provider])
  @@map("asset_prices")
}

// ─────────────────────────────────────────────────────────────
// Datos del hogar (payload cifrado)
// ─────────────────────────────────────────────────────────────

/// Cotización cargada a mano por el hogar; tiene prioridad sobre la pública. payload: { rate }
model HouseholdExchangeRate {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  base        String    @db.VarChar(10)
  quote       String    @db.VarChar(10)
  rateType    String    @default("official")
  date        DateTime  @db.Date
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, revision])
  @@map("household_exchange_rates")
}

/// Precio cargado a mano por el hogar (activo propio o valuación propia). payload: { price }
model ManualAssetPrice {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  assetId     String    @db.Uuid
  date        DateTime  @db.Date
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([householdId, revision])
  @@map("manual_asset_prices")
}

enum AccountType {
  CASH
  CHECKING // cuenta corriente / caja de ahorro
  SAVINGS
  DIGITAL_WALLET // Mercado Pago, Ualá…
  CREDIT_CARD
  INVESTMENT // broker / exchange
  LOAN
  OTHER
}

/// payload: { name, initialBalance, institution, color, icon, includeInNetWorth }
model Account {
  id          String      @id @default(uuid(7)) @db.Uuid
  householdId String      @db.Uuid
  ownerUserId String?     @db.Uuid // null = cuenta compartida del hogar
  type        AccountType
  currency    String      @db.VarChar(10)
  archivedAt  DateTime?   @db.Timestamptz
  payload     Bytes
  keyVersion  Int
  revision    BigInt      @default(0)
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz
  deletedAt   DateTime?   @db.Timestamptz

  household         Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner             User?                   @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  creditCard        CreditCard?
  transactions      Transaction[]
  recurringRules    RecurringRule[]
  debts             Debt[]
  savingsGoals      SavingsGoal[]
  investmentTrades  InvestmentTransaction[]
  fixedTermDeposits FixedTermDeposit[]

  @@index([householdId, revision])
  @@map("accounts")
}

/// payload: { network, lastFour, creditLimit }
model CreditCard {
  accountId   String    @id @db.Uuid
  householdId String    @db.Uuid
  closingDay  Int
  dueDay      Int
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  account          Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statements       CreditCardStatement[]
  installmentPlans InstallmentPlan[]

  @@index([householdId, revision])
  @@map("credit_cards")
}

enum StatementStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
}

/// payload: { totalAmount, minimumPayment, paidAmount }
model CreditCardStatement {
  id           String          @id @default(uuid(7)) @db.Uuid
  householdId  String          @db.Uuid
  creditCardId String          @db.Uuid
  periodStart  DateTime        @db.Date
  closingDate  DateTime        @db.Date
  dueDate      DateTime        @db.Date
  status       StatementStatus @default(OPEN)
  payload      Bytes
  keyVersion   Int
  revision     BigInt          @default(0)
  updatedAt    DateTime        @updatedAt @db.Timestamptz
  deletedAt    DateTime?       @db.Timestamptz

  creditCard   CreditCard        @relation(fields: [creditCardId], references: [accountId], onDelete: Cascade)
  installments CardInstallment[]

  @@unique([creditCardId, closingDate])
  @@index([householdId, revision])
  @@map("credit_card_statements")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

/// Grupo para el método 50/30/20.
enum BudgetGroup {
  NEEDS
  WANTS
  SAVINGS
}

/// payload: { name, icon, color }
model Category {
  id          String       @id @default(uuid(7)) @db.Uuid
  householdId String       @db.Uuid
  parentId    String?      @db.Uuid
  kind        CategoryKind
  budgetGroup BudgetGroup?
  systemKey   String? // categorías sembradas por defecto ("housing.rent")
  archivedAt  DateTime?    @db.Timestamptz
  payload     Bytes
  keyVersion  Int
  revision    BigInt       @default(0)
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  deletedAt   DateTime?    @db.Timestamptz

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgetItems    BudgetItem[]

  @@index([householdId, revision])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum TransactionStatus {
  PENDING
  CLEARED
}

/// Transferencia = dos filas (OUT + IN) con el mismo transferGroupId (permite cambio de moneda).
/// payload: { amount, description, notes }
model Transaction {
  id              String            @id @default(uuid(7)) @db.Uuid
  householdId     String            @db.Uuid
  accountId       String            @db.Uuid
  categoryId      String?           @db.Uuid
  type            TransactionType
  status          TransactionStatus @default(CLEARED)
  date            DateTime          @db.Date
  transferGroupId String?           @db.Uuid
  recurringRuleId String?           @db.Uuid
  createdById     String            @db.Uuid
  payload         Bytes
  keyVersion      Int
  revision        BigInt            @default(0)
  createdAt       DateTime          @default(now()) @db.Timestamptz
  updatedAt       DateTime          @updatedAt @db.Timestamptz
  deletedAt       DateTime?         @db.Timestamptz

  household        Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account          Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category         Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule    RecurringRule?         @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdBy        User                   @relation("TransactionCreator", fields: [createdById], references: [id])
  splits           TransactionSplit[]
  debtPayment      DebtPayment?
  installmentPlan  InstallmentPlan?
  goalContribution GoalContribution?
  investmentTrade  InvestmentTransaction?

  @@index([householdId, revision])
  @@index([householdId, date(sort: Desc)])
  @@index([accountId, date])
  @@index([transferGroupId])
  @@map("transactions")
}

/// Gasto compartido dividido entre miembros. payload: { amount }
model TransactionSplit {
  id            String    @id @default(uuid(7)) @db.Uuid
  householdId   String    @db.Uuid
  transactionId String    @db.Uuid
  userId        String    @db.Uuid
  settledAt     DateTime? @db.Timestamptz
  payload       Bytes
  keyVersion    Int
  revision      BigInt    @default(0)
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, userId])
  @@index([householdId, revision])
  @@map("transaction_splits")
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Sueldo, alquiler, suscripciones. El navegador genera las ocurrencias pendientes al abrir la app
/// (el servidor no puede: no conoce el monto). payload: { amount, description }
model RecurringRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  householdId String          @db.Uuid
  accountId   String          @db.Uuid
  categoryId  String?         @db.Uuid
  type        TransactionType
  frequency   Frequency
  interval    Int             @default(1)
  dayOfMonth  Int?
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date
  nextRunOn   DateTime        @db.Date
  autoPost    Boolean         @default(false) // true: se registra solo; false: se pide confirmación
  isSalary    Boolean         @default(false)
  active      Boolean         @default(true)
  payload     Bytes
  keyVersion  Int
  revision    BigInt          @default(0)
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz
  deletedAt   DateTime?       @db.Timestamptz

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([householdId, revision])
  @@map("recurring_rules")
}

// ─────────────────────────────────────────────────────────────
// Presupuesto
// ─────────────────────────────────────────────────────────────

enum BudgetMethod {
  CATEGORY
  FIFTY_THIRTY_TWENTY
  ENVELOPE
}

/// payload: { expectedIncome }
model Budget {
  id          String       @id @default(uuid(7)) @db.Uuid
  householdId String       @db.Uuid
  year        Int
  month       Int
  method      BudgetMethod @default(CATEGORY)
  currency    String       @db.VarChar(10)
  payload     Bytes
  keyVersion  Int
  revision    BigInt       @default(0)
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  deletedAt   DateTime?    @db.Timestamptz

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     BudgetItem[]

  @@unique([householdId, year, month])
  @@index([householdId, revision])
  @@map("budgets")
}

/// payload: { amount }
model BudgetItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  householdId    String    @db.Uuid
  budgetId       String    @db.Uuid
  categoryId     String    @db.Uuid
  rollover       Boolean   @default(false)
  alertThreshold Int       @default(80)
  payload        Bytes
  keyVersion     Int
  revision       BigInt    @default(0)
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([householdId, revision])
  @@map("budget_items")
}

// ─────────────────────────────────────────────────────────────
// Deudas, préstamos y cuotas de tarjeta
// ─────────────────────────────────────────────────────────────

enum DebtKind {
  PERSONAL_LOAN
  MORTGAGE
  CAR_LOAN
  CREDIT_CARD_BALANCE
  FAMILY_OR_FRIEND
  OTHER
}

enum InterestRateType {
  FIXED
  VARIABLE
  INDEXED // UVA, CER…
  NONE
}

enum AmortizationSystem {
  FRENCH
  GERMAN
  BULLET
  CUSTOM
}

enum DebtStatus {
  ACTIVE
  PAID_OFF
  DEFAULTED
  CANCELLED
}

/// payload: { name, lender, originalAmount, annualRate, indexName, minimumPayment }
model Debt {
  id           String             @id @default(uuid(7)) @db.Uuid
  householdId  String             @db.Uuid
  accountId    String?            @db.Uuid
  kind         DebtKind
  currency     String             @db.VarChar(10)
  rateType     InterestRateType   @default(FIXED)
  amortization AmortizationSystem @default(FRENCH)
  termMonths   Int?
  startDate    DateTime           @db.Date
  paymentDay   Int?
  status       DebtStatus         @default(ACTIVE)
  payload      Bytes
  keyVersion   Int
  revision     BigInt             @default(0)
  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz
  deletedAt    DateTime?          @db.Timestamptz

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments  DebtPayment[]

  @@index([householdId, revision])
  @@map("debts")
}

/// payload: { amount, principalPart, interestPart, feesPart }
model DebtPayment {
  id            String    @id @default(uuid(7)) @db.Uuid
  householdId   String    @db.Uuid
  debtId        String    @db.Uuid
  transactionId String?   @unique @db.Uuid
  date          DateTime  @db.Date
  payload       Bytes
  keyVersion    Int
  revision      BigInt    @default(0)
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  debt        Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([householdId, revision])
  @@map("debt_payments")
}

/// Compra en cuotas. payload: { totalAmount, installmentAmount }
model InstallmentPlan {
  id                String    @id @default(uuid(7)) @db.Uuid
  householdId       String    @db.Uuid
  creditCardId      String    @db.Uuid
  transactionId     String    @unique @db.Uuid
  installmentsCount Int
  interestFree      Boolean   @default(true)
  firstStatementOn  DateTime  @db.Date
  payload           Bytes
  keyVersion        Int
  revision          BigInt    @default(0)
  updatedAt         DateTime  @updatedAt @db.Timestamptz
  deletedAt         DateTime? @db.Timestamptz

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  creditCard   CreditCard        @relation(fields: [creditCardId], references: [accountId], onDelete: Cascade)
  transaction  Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  installments CardInstallment[]

  @@index([householdId, revision])
  @@map("installment_plans")
}

/// payload: { amount }
model CardInstallment {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  planId      String    @db.Uuid
  number      Int
  dueMonth    DateTime  @db.Date
  statementId String?   @db.Uuid
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  plan      InstallmentPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  statement CreditCardStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@unique([planId, number])
  @@index([householdId, revision])
  @@map("card_installments")
}

// ─────────────────────────────────────────────────────────────
// Ahorro e inversiones
// ─────────────────────────────────────────────────────────────

enum GoalKind {
  EMERGENCY_FUND
  SAVINGS_GOAL
  RETIREMENT
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

/// payload: { name, targetAmount, monthsOfExpenses }
model SavingsGoal {
  id          String     @id @default(uuid(7)) @db.Uuid
  householdId String     @db.Uuid
  accountId   String?    @db.Uuid
  kind        GoalKind   @default(SAVINGS_GOAL)
  currency    String     @db.VarChar(10)
  targetDate  DateTime?  @db.Date
  priority    Int        @default(0)
  status      GoalStatus @default(ACTIVE)
  payload     Bytes
  keyVersion  Int
  revision    BigInt     @default(0)
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz
  deletedAt   DateTime?  @db.Timestamptz

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([householdId, revision])
  @@map("savings_goals")
}

/// payload: { amount, note }  (monto negativo = retiro)
model GoalContribution {
  id            String    @id @default(uuid(7)) @db.Uuid
  householdId   String    @db.Uuid
  goalId        String    @db.Uuid
  transactionId String?   @unique @db.Uuid
  date          DateTime  @db.Date
  payload       Bytes
  keyVersion    Int
  revision      BigInt    @default(0)
  updatedAt     DateTime  @updatedAt @db.Timestamptz
  deletedAt     DateTime? @db.Timestamptz

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([householdId, revision])
  @@map("goal_contributions")
}

enum InvestmentTxType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  FEE
  SPLIT
}

/// Las tenencias se derivan de las operaciones. payload: { quantity, unitPrice, fees, notes }
model InvestmentTransaction {
  id                String           @id @default(uuid(7)) @db.Uuid
  householdId       String           @db.Uuid
  accountId         String           @db.Uuid
  assetId           String           @db.Uuid
  cashTransactionId String?          @unique @db.Uuid
  type              InvestmentTxType
  date              DateTime         @db.Date
  payload           Bytes
  keyVersion        Int
  revision          BigInt           @default(0)
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz
  deletedAt         DateTime?        @db.Timestamptz

  household       Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  asset           Asset        @relation(fields: [assetId], references: [id])
  cashTransaction Transaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)

  @@index([householdId, revision])
  @@map("investment_transactions")
}

enum DepositStatus {
  ACTIVE
  MATURED
  RENEWED
  CANCELLED
}

/// Plazo fijo. payload: { institution, principal, annualRate }
model FixedTermDeposit {
  id           String           @id @default(uuid(7)) @db.Uuid
  householdId  String           @db.Uuid
  accountId    String           @db.Uuid
  currency     String           @db.VarChar(10)
  rateType     InterestRateType @default(FIXED)
  startDate    DateTime         @db.Date
  maturityDate DateTime         @db.Date
  autoRenew    Boolean          @default(false)
  status       DepositStatus    @default(ACTIVE)
  payload      Bytes
  keyVersion   Int
  revision     BigInt           @default(0)
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz
  deletedAt    DateTime?        @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([householdId, revision])
  @@map("fixed_term_deposits")
}

// ─────────────────────────────────────────────────────────────
// "De 0 a 100": puntaje, hitos, patrimonio, tips
// (calculados en el navegador y guardados cifrados)
// ─────────────────────────────────────────────────────────────

/// payload: { score, components: { savingsRate, debtToIncome, emergencyMonths, budgetAdherence… } }
model FinancialHealthScore {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  date        DateTime  @db.Date
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, date])
  @@index([householdId, revision])
  @@map("financial_health_scores")
}

/// payload: { milestoneKey }  (cifrado: revela la situación financiera)
model MilestoneCompletion {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  completedAt DateTime  @default(now()) @db.Timestamptz
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, revision])
  @@map("milestone_completions")
}

/// payload: { assets, liabilities, netWorth, breakdown }
model NetWorthSnapshot {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  date        DateTime  @db.Date
  currency    String    @db.VarChar(10)
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, date])
  @@index([householdId, revision])
  @@map("net_worth_snapshots")
}

/// Los tips viven en el código; acá solo se registra cuáles descartó cada usuario.
model TipDismissal {
  userId      String   @db.Uuid
  tipKey      String
  dismissedAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tipKey])
  @@map("tip_dismissals")
}

// ─────────────────────────────────────────────────────────────
// Recordatorios y notificaciones
// ─────────────────────────────────────────────────────────────

/// Agendado por el navegador. El servidor solo conoce la fecha; el texto va cifrado con la
/// clave del hogar. A `remindAt`, un job (BullMQ) crea una Notification por miembro activo.
/// payload: { title, body, link }
model Reminder {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @db.Uuid
  createdById String    @db.Uuid
  sourceId    String?   @db.Uuid // registro que lo originó (resumen, deuda, plazo fijo…)
  remindAt    DateTime  @db.Timestamptz
  firedAt     DateTime? @db.Timestamptz
  payload     Bytes
  keyVersion  Int
  revision    BigInt    @default(0)
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([firedAt, remindAt])
  @@index([householdId, revision])
  @@map("reminders")
}

enum NotificationType {
  REMINDER // viene de un Reminder: contenido cifrado (payload)
  LOCAL_ALERT // calculada en el navegador (presupuesto excedido, meta lograda…): cifrada
  HOUSEHOLD_INVITATION // del sistema: texto en claro sin datos financieros
  MEMBER_PENDING_KEY // del sistema: un miembro espera que le compartan la clave
  SECURITY // del sistema: inicio de sesión nuevo, cambio de claves
}

/// Notificaciones de sistema: title/body en claro (sin datos financieros).
/// Notificaciones con datos: payload cifrado con la clave del hogar.
model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @db.Uuid
  householdId String?          @db.Uuid
  reminderId  String?          @db.Uuid
  type        NotificationType
  title       String?
  body        String?
  payload     Bytes?
  keyVersion  Int?
  dedupeKey   String?
  readAt      DateTime?        @db.Timestamptz
  createdAt   DateTime         @default(now()) @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  reminder  Reminder?  @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}
