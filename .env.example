# Copiar a .env y cambiar las contraseñas (en producción, siempre).
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas_dev
POSTGRES_DB=finanzas
POSTGRES_PORT=5432

REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

FRONTEND_PORT=8080
PUBLIC_URL=http://localhost:8080

# Firma de access tokens: generar con `openssl rand -base64 48` (distinto en producción)
JWT_SECRET=cambiar-por-openssl-rand-base64-48-------------------

# Web Push: `npx web-push generate-vapid-keys` (distintas en producción)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
