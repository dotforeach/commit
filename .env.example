# Copiar a .env y cambiar las contraseñas (en producción, siempre).
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas_dev
POSTGRES_DB=finanzas
POSTGRES_PORT=5432

REDIS_PASSWORD=redis_dev
REDIS_PORT=6379

FRONTEND_PORT=8080
PUBLIC_URL=http://localhost:8080

# Firma de access tokens: generar con `openssl rand -base64 48` (distinto en producción)
JWT_SECRET=cambiar-por-openssl-rand-base64-48-------------------

# Web Push: `npx web-push generate-vapid-keys` (distintas en producción)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Intentos de login/registro por minuto por IP (producción: 10)
# AUTH_RATE_LIMIT=10

# ── Facturas por WhatsApp (opcional) ──────────────────────────
# Credenciales de la WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número público de Commit, solo dígitos con código de país (para el link wa.me)
WHATSAPP_DISPLAY_NUMBER=
# Clave de la API de Claude (extracción y clasificación)
ANTHROPIC_API_KEY=
# OCR propio: levantar con `docker compose --profile ocr up -d ocr` y descomentar
# OCR_URL=http://ocr:8000
# Opcionales (tienen valor por defecto)
# EXTRACTION_MODEL=claude-opus-5-5
# RECEIPTS_MONTHLY_LIMIT=100
# Clave del HMAC del número (si falta, se deriva de JWT_SECRET). Cambiarla desvincula los números ya vinculados.
# PHONE_HASH_KEY=
# WHATSAPP_GRAPH_VERSION=v23.0
# Exigir suscripción para procesar comprobantes (en producción: true)
SUBSCRIPTIONS_ENFORCED=false

# Token de operador para ver /estado en producción (sin él, /estado responde 404)
STATUS_TOKEN=

# ── Correo (verificación de cuenta, contraseña olvidada, avisos) ──
# En desarrollo se usa Mailpit (http://localhost:8025) automáticamente.
# Resend:  SMTP_URL=smtps://resend:<API_KEY>@smtp.resend.com:465
# Azure:   SMTP_URL=smtp://<SMTP_USERNAME>:<CLIENT_SECRET>@smtp.azurecomm.net:587
SMTP_URL=
MAIL_FROM=Commit <no-reply@tudominio.com>
